{
  "name": "subdesk-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "node --env-file=.env src/local.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "powershell -File scripts/check.ps1",
    "validate:api": "redocly lint docs/api/openapi.yaml",
    "validate:iac": "cfn-lint template.yaml",
    "docs:diagrams": "node scripts/export-diagrams.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/lib-dynamodb": "3.1175.0",
    "express": "5.3.0",
    "serverless-http": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@redocly/cli": "2.81.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "js-yaml": "5.5.0",
    "supertest": "7.3.2"
  }
}
