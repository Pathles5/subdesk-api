{
  "name": "subdesk-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "node --env-file=.env src/local.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "powershell -File scripts/check.ps1",
    "validate:api": "redocly lint docs/api/openapi.yaml"
  },
  "dependencies": {
    "express": "5.3.0",
    "serverless-http": "3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.81.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "js-yaml": "5.5.0",
    "supertest": "7.3.2"
  }
}
