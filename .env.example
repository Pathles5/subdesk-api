# Copy this file to .env for local development (`pnpm run dev` loads it via --env-file).
# NEVER commit real values: secrets stay out of git and are injected into Lambda as
# SAM parameters with NoEcho (I4). The seven names are fixed by D-17 (phase 00 spec, section 6).
# PORT is local-only (src/local.js); it does not exist in the Lambda runtime (Function URL).
TABLE_NAME=<TABLE_NAME>
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
ADMIN_API_KEY=<ADMIN_API_KEY>
TELEGRAM_WEBHOOK_SECRET=<TELEGRAM_WEBHOOK_SECRET>
LOG_LEVEL=info
STAGE=dev
PORT=3000
