flowchart LR
    subgraph dev["Desarrollo (local)"]
        REPO["repo git<br/>src/ + template.yaml"]
        GATES["compuertas<br/>pnpm lint/test<br/>validate:api/validate:iac<br/>check.ps1"]
    end

    VISTO["visto I6 = la accion de disparo (D-48)<br/>push a main AUTORIZADO → deploy<br/>workflow_dispatch + literal BORRO-SUBDESK-API-DEV → prune<br/>no hay Waiting ni reviewers"]

    subgraph ci["GitHub Actions — pipeline (Fase 04; D-42: unico ejecutor de AWS)"]
        Wf["deploy.yml<br/>verify → package<br/>compuertas + ZIP determinista<br/>nodeLinker hoisted (D-31)"]
        ENVID["environment: dev<br/>scope de secretos + claim OIDC<br/>sub = repo:Pathles5@43617338/subdesk-api@1462037116:environment:dev (INMUTABLE, D-50)"]
        SECRETS["Secretos del environment<br/>TELEGRAM_BOT_TOKEN · ADMIN_API_KEY<br/>TELEGRAM_WEBHOOK_SECRET"]
    end

    OIDC["STS via OIDC<br/>SubDeskCiDeployRole · role-to-assume<br/>cero claves de largo vivir (D-43)<br/>policy auditada (A-03.3 / D-49)"]

    subgraph cfn["CloudFormation stack (us-east-1) — SAM transform D-15"]
        TABLE[("TicketsTable<br/>PROVISIONED 25/25 · Standard<br/>PK id(S) · sin indices · SSE<br/>I2/D-26")]
        FN["TicketApiFunction<br/>nodejs22.x · x86_64 · 256 MB · 30s<br/>handler src/lambda.handler<br/>D-27/D-40"]
